# Highlight picker: heuristic (default, offline) | mock | openai | openrouter | groq | ollama | lmstudio | anthropic
SHORTS_FORGE_LLM_PROVIDER=heuristic
# SHORTS_FORGE_LLM_MODEL=gpt-4o-mini
# SHORTS_FORGE_LLM_BASE_URL=http://localhost:11434/v1

# Keys (only the one for your provider is needed)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Speech-to-text when using --stt openai (any OpenAI-compatible /audio/transcriptions endpoint)
# SHORTS_FORGE_STT_MODEL=whisper-1
# SHORTS_FORGE_STT_BASE_URL=https://api.groq.com/openai/v1
# SHORTS_FORGE_STT_API_KEY=
